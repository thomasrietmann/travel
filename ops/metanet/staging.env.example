# Template for the isolated acceptance installation, never for production.
# Copy to its own .env before booting Laravel; fill secrets only on the host.
APP_NAME="TripControl Staging"
APP_ENV=staging
APP_DEBUG=false
APP_URL=https://travel-at.aufbollen.ch
# Retain the key belonging to the backup for the preservation check; never generate a replacement.
APP_KEY=
HASH_DRIVER=bcrypt

STAGING_CHECKS_ENABLED=true
STAGING_MAIL_RECIPIENT=travel.at@aufbollen.ch
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=travel-at
DB_USERNAME=
DB_PASSWORD=
DB_URL=
DB_SOCKET=

SESSION_DRIVER=database
SESSION_COOKIE=tripcontrol_staging_session
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_ENCRYPT=false
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
# Empty values use this staging project's storage, never production paths.
# For chroot overrides use only verified staging-owned directories.
FILESYSTEM_LOCAL_ROOT=
FILESYSTEM_PUBLIC_ROOT=
FILESYSTEM_PRIVATE_FALLBACK_ROOTS=
FILESYSTEM_PUBLIC_FALLBACK_ROOTS=
SESSION_FILES_PATH=
CACHE_FILE_PATH=
VIEW_PATH=
VIEW_COMPILED_PATH=
PROCESS_LOCK_PATH=
LOG_PATH=
AUDIT_LOG_PATH=
LOG_LEVEL=warning

# Keep normal application mail disabled until the explicit mail acceptance phase.
MAIL_MAILER=array
MAIL_SCHEME=smtps
MAIL_PORT=465
MAIL_HOST=
MAIL_USERNAME=travel.at@aufbollen.ch
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=travel.at@aufbollen.ch
MAIL_FROM_NAME="TripControl Staging"
MAIL_EHLO_DOMAIN=travel-at.aufbollen.ch
MAIL_IMPORT_ENABLED=false
MAIL_IMPORT_AUTH_RESULTS_TRUSTED=false
MAIL_IMPORT_AUTHSERV_IDS=
MAIL_IMPORT_RECIPIENT=travel.at@aufbollen.ch
# Set the exact TLS host from Plesk, e.g. {HOST:993/imap/ssl}INBOX.
MAIL_IMPORT_IMAP_MAILBOX=
MAIL_IMPORT_IMAP_USERNAME=travel.at@aufbollen.ch
MAIL_IMPORT_IMAP_PASSWORD=
MAIL_IMPORT_IMAP_SEARCH=UNSEEN
MAIL_IMPORT_MAX_MESSAGES=1
MAIL_IMPORT_MARK_SEEN=true
MAIL_IMPORT_LOG_PATH=

# No real AI calls during restore / initial acceptance.
OPENAI_API_KEY=
AI_DAILY_LIMIT=1
